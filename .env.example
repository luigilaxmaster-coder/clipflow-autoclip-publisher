# ==============================================================================
# AutoClip Publisher — Personal Edition
# Plantilla de variables de entorno (NO almacenar secretos reales ni fijos aquí)
# Genera secretos aleatorios con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Seguridad de Propietario Único & Cifrado Local (OBLIGATORIOS)
# ------------------------------------------------------------------------------
# Token maestro único del propietario para acceder al Dashboard y la API
OWNER_TOKEN=

# Clave secreta única para derivar el cifrado simétrico Fernet (256-bit)
CREDENTIALS_ENCRYPTION_KEY=

# Entorno: "production" prohíbe estrictamente cualquier modo mock
AUTOCLIP_ENV=production

# ------------------------------------------------------------------------------
# 2. Secretos de Servicios Docker para Postiz (OBLIGATORIOS si usas Docker)
# ------------------------------------------------------------------------------
POSTGRES_DB=postiz
POSTGRES_USER=postiz
POSTGRES_PASSWORD=
REDIS_PASSWORD=
POSTIZ_JWT_SECRET=

# ------------------------------------------------------------------------------
# 3. Motor de Publicación Postiz (Self-Hosted AGPL-3.0)
# ------------------------------------------------------------------------------
POSTIZ_API_URL=http://127.0.0.1:4007
POSTIZ_API_KEY=

# Motor preferido de publicación: "auto", "native", "postiz", o "upload_post"
PUBLISHER_ENGINE=auto

# ------------------------------------------------------------------------------
# 4. Conector Nativo Directo para YouTube (Recomendado: guardar vía UI o set-youtube-credentials.ps1)
# ------------------------------------------------------------------------------
# Puedes configurar Client ID y Client Secret desde /connections y autorizar vía Google OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_DAILY_QUOTA_UNITS=10000

# Conector Nativo Directo para TikTok (Content Posting API v2 + OAuth 2.0)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Si TikTok exige HTTPS para callback, usa tu túnel Cloudflare/ngrok aquí:
TIKTOK_REDIRECT_URI=

# ------------------------------------------------------------------------------
# 5. Compatibilidad con Upload-Post (Opcional / Legacy Fallback)
# ------------------------------------------------------------------------------
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=main
UPLOAD_POST_API_BASE=https://api.upload-post.com

# ------------------------------------------------------------------------------
# 6. AutoClip Engine & Modelos IA
# ------------------------------------------------------------------------------
AUTOCLIP_API_KEY=
AUTOCLIP_PROVIDER=openai
AUTOCLIP_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 7. Base de Datos Local & Zona Horaria
# ------------------------------------------------------------------------------
CLIPFLOW_DATABASE_URL=sqlite:///data/clipflow.db
CLIPFLOW_DATA_DIR=data
CLIPFLOW_TIMEZONE=America/Santo_Domingo
CLIPFLOW_LOG_LEVEL=INFO
