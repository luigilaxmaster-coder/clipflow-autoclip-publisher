# AutoClip Publisher - Variables de Entorno de Ejemplo
# NO colocar credenciales reales en este archivo versionado.

# 1. Configuración de Modelos de Inteligencia Artificial (AutoClip)
# Opcional si se utiliza un modelo local como Ollama o LM Studio
AUTOCLIP_API_KEY=
# AUTOCLIP_PROVIDER=openai
# AUTOCLIP_BASE_URL=https://api.openai.com/v1
# AUTOCLIP_MODEL=gpt-4o-mini

# 2. Configuración de Publicación (Upload-Post)
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=main
UPLOAD_POST_API_BASE=https://api.upload-post.com

# 3. Directorio de Datos y Base de Datos Local
CLIPFLOW_DATA_DIR=C:/Users/PD2/.gemini/antigravity/scratch/autoclip-publisher/data
CLIPFLOW_DATABASE_URL=sqlite:///C:/Users/PD2/.gemini/antigravity/scratch/autoclip-publisher/data/clipflow.db

# 4. Zona Horaria y Entorno
CLIPFLOW_TIMEZONE=America/Santo_Domingo
CLIPFLOW_LOG_LEVEL=INFO
