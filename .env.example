# ==============================================================================
# AutoClip Publisher — Personal Edition
# Plantilla de variables de entorno seguras (NO almacenar credenciales reales aquí)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Seguridad de Propietario Único & Cifrado Local
# ------------------------------------------------------------------------------
# Token maestro o clave de acceso para desbloquear el Dashboard personal
OWNER_TOKEN=mi_clave_maestra_privada_2026

# Clave secreta base para derivación de cifrado simétrico Fernet (32 bytes)
CREDENTIALS_ENCRYPTION_KEY=clave_secreta_super_segura_para_cifrado_fernet

# Permitir acceso directo desde localhost sin pantalla de login (true / false)
ALLOW_LOCALHOST_DEV=true

# ------------------------------------------------------------------------------
# 2. Motor de Publicación Postiz (Self-Hosted AGPL-3.0)
# ------------------------------------------------------------------------------
# URL de la instancia de Postiz (local en puerto 4007 o contenedor Docker)
POSTIZ_API_URL=http://localhost:4007

# Clave API generada en tu Postiz autohospedado (Settings > API Keys)
POSTIZ_API_KEY=

# Motor preferido de publicación: "auto", "native", "postiz", o "upload_post"
PUBLISHER_ENGINE=auto

# ------------------------------------------------------------------------------
# 3. Conector Nativo Directo para YouTube (Google OAuth 2.0)
# ------------------------------------------------------------------------------
# Obtenidas en Google Cloud Console > APIs & Services > Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 4. Compatibilidad con Upload-Post (Opcional / Fallback)
# ------------------------------------------------------------------------------
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=main
UPLOAD_POST_API_BASE=https://api.upload-post.com

# ------------------------------------------------------------------------------
# 5. Configuración de AutoClip Engine & Modelos IA Locales / API
# ------------------------------------------------------------------------------
# Clave opcional si se usa un modelo remoto (OpenAI, Gemini, Groq, etc.)
# O déjalo en blanco si se usan modelos locales con faster-whisper y Ollama
AUTOCLIP_API_KEY=
AUTOCLIP_PROVIDER=openai
AUTOCLIP_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 6. Base de Datos Local & Zona Horaria
# ------------------------------------------------------------------------------
CLIPFLOW_DATABASE_URL=sqlite:///data/clipflow.db
CLIPFLOW_DATA_DIR=data
CLIPFLOW_TIMEZONE=America/Santo_Domingo
CLIPFLOW_LOG_LEVEL=INFO
