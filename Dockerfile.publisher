# Dockerfile para ClipFlow Publisher & Web Admin (Python 3.11)
FROM python:3.11-slim

# Instalar dependencias del sistema requeridas para FFmpeg y libmagic
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar definiciones de dependencias
COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# Copiar código fuente
COPY . .

# Crear directorios de datos
RUN mkdir -p /app/data /app/runs /app/clips_para_seleccion

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["python", "-m", "uvicorn", "clipflow.web.app:app", "--host", "0.0.0.0", "--port", "8000"]
